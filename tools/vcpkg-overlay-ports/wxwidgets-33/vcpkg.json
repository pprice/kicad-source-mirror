{
  "name": "wxwidgets-33",
  "version": "3.3.4",
  "port-version": 0,
  "description": "Widget toolkit and tools library for creating graphical user interfaces (GUIs) for cross-platform applications. ",
  "homepage": "https://github.com/wxWidgets/wxWidgets",
  "license": "LGPL-2.0-or-later WITH WxWindows-exception-3.1 AND HPND",
  "supports": "!uwp & !xbox",
  "dependencies": [
    {
      "name": "cairo",
      "default-features": false,
      "platform": "!windows & !osx & !ios"
    },
    {
      "name": "curl",
      "default-features": false,
      "platform": "!windows & !osx"
    },
    "expat",
    {
      "name": "gtk3",
      "platform": "!windows & !osx & !ios"
    },
    {
      "name": "gettext",
      "host": true,
      "default-features": false,
      "features": [
        "tools"
      ]
    },
    {
      "name": "libiconv",
      "platform": "!windows"
    },
    "libjpeg-turbo",
    "libpng",
    {
      "name": "libsm",
      "platform": "!windows & !osx & !ios"
    },
    "libwebp",
    "nanosvg",
    "opengl",
    {
      "name": "pcre2",
      "default-features": false
    },
    {
      "name": "tiff",
      "default-features": false
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zlib"
  ],
  "default-features": [
    "debug-support",
    "sound"
  ],
  "features": {
    "debug-support": {
      "description": "Enable wxWidgets debugging support hooks even for release builds (wxDEBUG_LEVEL 1)"
    },
    "example": {
      "description": "Example source code and CMake project"
    },
    "fatal": {
      "description": "wxUSE_ON_FATAL_EXCEPTION"
    },
    "crash": {
      "description": "wxUSE_CRASHREPORT"
    },
    "fonts": {
      "description": "Enable to use the font functionality of wxWidgets",
      "dependencies": [
        {
          "name": "fontconfig",
          "platform": "!windows & !osx"
        },
        {
          "name": "pango",
          "platform": "!windows & !osx"
        }
      ]
    },
    "media": {
      "description": "Build wxMediaCtrl support",
      "dependencies": [
        {
          "name": "gstreamer",
          "default-features": false,
          "platform": "!windows & !osx & !ios"
        }
      ]
    },
    "secretstore": {
      "description": "Use wxSecretStore class",
      "dependencies": [
        {
          "name": "libsecret",
          "platform": "!windows & !osx & !ios"
        }
      ]
    },
    "sound": {
      "description": "Build wxSound support",
      "dependencies": [
        {
          "name": "sdl2",
          "default-features": false,
          "platform": "!windows & !osx & !ios"
        }
      ]
    },
    "webview": {
      "description": "The Edge backend uses Microsoft's Edge WebView2",
      "dependencies": [
        {
          "name": "webview2",
          "platform": "windows"
        }
      ]
    }
  }
}
